# ===================================
# AnonChatGate (AguGram) Environment Variables
# ===================================
# Скопируйте этот файл в .env и заполните своими значениями

# === Database Configuration ===
DATABASE_URL=postgresql://user:password@host:port/database_name
# Примеры:
# Neon: postgresql://username:password@ep-xxx.region.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Local: postgresql://postgres:password@localhost:5432/anonchatgate

# === Telegram Bot Configuration ===
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
# Получить у @BotFather в Telegram

# === Admin Configuration ===
TELEGRAM_ADMIN_ID=123456789
# Ваш Telegram User ID (узнать у @userinfobot)

# === Application URL ===
WEBAPP_URL=https://your-app-url.com
# Для разработки используйте ngrok или Replit URL
# Для production: ваш домен с HTTPS

# === WebSocket Configuration (for Telegram Mini App) ===
VITE_WS_HOST=your-domain.com:5000
# WebSocket host для Telegram Mini App
# Формат: domain:port (без протокола)
# Примеры:
# - Для локальной разработки: localhost:3000
# - Для production: your-app-url.com (без порта если стандартный 80/443)
# - Для ngrok: your-ngrok-id.ngrok.io

# === Security & Authentication ===
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_random_string
# Генерация: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ВАЖНО: В production должен быть минимум 32 символа!

# === Server Configuration ===
NODE_ENV=development
# development | production

DEV_MODE=true
# true | false
# В production должно быть false

PORT=5000
# Порт для сервера (по умолчанию 5000)

# === Optional Features ===

# Moderation System (по умолчанию отключена)
# ENABLE_MODERATION=false

# Cloudinary для загрузки изображений (опционально)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# === Logging Configuration ===
LOG_LEVEL=info
# Уровень логирования (debug | info | warn | error)
# debug - детальная информация для разработки
# info - стандартный уровень для production (рекомендуется)
# warn - только предупреждения и ошибки
# error - только ошибки

# Redis для кэширования (опционально)
# REDIS_URL=redis://localhost:6379
