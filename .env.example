# ===================================
# AnonChatGate (AguGram) Environment Variables
# ===================================
# Скопируйте этот файл в .env и заполните своими значениями

# === Database Configuration ===
DATABASE_URL=postgresql://user:password@host:port/database_name
# Примеры:
# Neon: postgresql://username:password@ep-xxx.region.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Local: postgresql://postgres:password@localhost:5432/anonchatgate

# === Telegram Bot Configuration ===
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Secret header used to authenticate Telegram webhook requests in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=<generate-a-random-base64url-secret>
# Получить у @BotFather в Telegram

# === Admin Configuration ===
TELEGRAM_ADMIN_ID=123456789
# Ваш Telegram User ID (узнать у @userinfobot)

# === Application URL ===
# Render автоматически предоставляет стабильный RENDER_EXTERNAL_URL; WEBAPP_URL
# там не нужен и не может перебить managed URL. Для локальной разработки или
# другой платформы укажите стабильный HTTPS URL (например, staging/custom domain).
WEBAPP_URL=https://your-staging-domain.example

# === Security & Authentication ===
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_random_string
# Генерация: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ВАЖНО: В production должен быть минимум 32 символа!

# === Server Configuration ===
NODE_ENV=production
# development | production
# ВАЖНО: Для работы на серверах должно быть production

PORT=5000
# Порт для сервера
# Railway/Render автоматически устанавливают свой PORT

# === Bot Mode (для production) ===
# USE_WEBHOOK=true
# В production автоматически используется webhook
# Для локальной разработки используется polling

# ENABLE_BOT_POLLING=true
# Только для dev: включить polling вместо webhook

# === Optional Features ===

# Moderation System (по умолчанию отключена)
# ENABLE_MODERATION=false

# Cloudinary для загрузки изображений (опционально)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# === Logging Configuration ===
LOG_LEVEL=info
# Уровень логирования (debug | info | warn | error)
# debug - детальная информация для разработки
# info - стандартный уровень для production (рекомендуется)
# warn - только предупреждения и ошибки
# error - только ошибки

# Redis для кэширования (опционально)
# REDIS_URL=redis://localhost:6379
